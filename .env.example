# Plantilla de variables de entorno. Copiar a .env y completar.
# Ningún valor real va en el repositorio. Los secretos se rotan si alguna vez se expusieron.

# --- Base de datos y seguridad (obligatorias) ---
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/checkapp
APP_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=info
# Orígenes permitidos para la WEB, separados por coma.
CORS_ORIGINS=http://localhost:5002,http://localhost:5004
# URL pública de la WEB (enlace "Ir al Panel de Control" de los correos).
SYSTEM_URL=http://localhost:5002/#/home

# --- Límites ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UPLOAD_MAX=30
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=10

# --- Correo saliente (incidentes y mantenimientos) ---
# Remitente visible, por ejemplo: Sistema <no-responder@ejemplo.com>
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional: si está, se usa Resend en lugar de SMTP.
RESEND_API_KEY=

# --- Almacenamiento de evidencias (S3) ---
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Servicios opcionales ---
ABLY_KEY=
GOOGLE_MAPS_API_KEY=

# --- Datos de demostración (NUNCA en producción) ---
# SEED_DEMO=true crea usuarios de prueba con contraseñas conocidas.
SEED_DEMO=false
