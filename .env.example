# Plantilla de variables de entorno. Copiar a .env y completar.
# Ningún valor real va en el repositorio. Los secretos se rotan si alguna vez se expusieron.

# --- Base de datos y seguridad (obligatorias) ---
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/checkapp
APP_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=info
# Orígenes permitidos para la WEB, separados por coma.
CORS_ORIGINS=http://localhost:5002,http://localhost:5004
# URL pública de la WEB (enlace "Ir al Panel de Control" de los correos).
SYSTEM_URL=http://localhost:5002/#/home

# --- Límites ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UPLOAD_MAX=30
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=10

# --- Correo saliente (incidentes y mantenimientos) ---
# Remitente visible, por ejemplo: Sistema <no-responder@ejemplo.com>
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional: si está, se usa Resend en lugar de SMTP.
RESEND_API_KEY=

# --- Almacenamiento de evidencias (S3) ---
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Push notifications (FCM/Firebase) ---
# Proyecto de Firebase (google-services.json → project_info.project_id).
FIREBASE_PROJECT_ID=axzy-checkapp
# Server key de Cloud Messaging (API legacy). Si usas HTTP v1, deja vacío y configura la cuenta de servicio.
FCM_SERVER_KEY=
# Cuenta de servicio para FCM HTTP v1 (recomendado en producción).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Ruta local al JSON de la cuenta de servicio (no se versiona).
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternativa para Railway: JSON completo en una variable (o base64).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Servicios opcionales ---
ABLY_KEY=
GOOGLE_MAPS_API_KEY=

# --- Datos de demostración (NUNCA en producción) ---
# SEED_DEMO=true crea usuarios de prueba con contraseñas conocidas.
SEED_DEMO=false

# --- Seguridad de sesión (auditoría S-25, S-26, S-27) ---
# APP_SECRET debe tener 32+ caracteres aleatorios (en producción la API no arranca con uno más corto).
# Vigencia del token de sesión (p. ej. 12h, 1d). La revocación por cierre de sesión o cambio de contraseña es inmediata.
JWT_EXPIRES_IN=1d
# Intentos de inicio de sesión fallidos por cuenta antes de bloquearla, y minutos de bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Saltos de proxy de confianza para leer la IP real (Railway: 1). 0 = sin proxy.
TRUST_PROXY=0

# --- Archivos (S3) ---
# Las URLs de archivos salen firmadas y vencen en este tiempo (segundos). El bucket debe tener "Block all public access" activado.
MEDIA_URL_TTL_SECONDS=3600
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Base de datos local de desarrollo (auditoría S-19) ---
# pnpm db:dev:up levanta Postgres en el puerto 55434. Los comandos que escriben en la base
# (prisma:migrate, prisma:seed, prisma:restore) se detienen si DATABASE_URL es remota, salvo ALLOW_REMOTE_DB=1.
# DATABASE_URL=postgresql://postgres:dev@localhost:55434/checkapp_dev
# ALLOW_REMOTE_DB=1
