generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  value       String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PropertyType {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  value      String
  properties Property[]
  active     Boolean    @default(true)
  order      Int        @default(0)
  isSystem   Boolean    @default(false)
}

model PropertyStatus {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  value      String
  properties Property[]
  active     Boolean    @default(true)
  order      Int        @default(0)
  isSystem   Boolean    @default(false)
}

model InvitationType {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  value       String
  invitations Invitation[]
  active      Boolean      @default(true)
  order       Int          @default(0)
  isSystem    Boolean      @default(false)
}

model User {
  id                       Int                      @id @default(autoincrement())
  name                     String
  lastName                 String?
  username                 String                   @unique
  password                 String
  active                   Boolean                  @default(true)
  softDelete               Boolean                  @default(false)
  shiftStart               String?
  shiftEnd                 String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  isLoggedIn               Boolean                  @default(false)
  recurringConfigurationId Int?
  scheduleId               Int?
  propertyId               Int?
  roleId                   Int
  assignments              Assignment[]             @relation("GuardAssignments")
  incidents                Incident[]
  resolvedIncidents        Incident[]               @relation("IncidentResolver")
  invitationsCreated       Invitation[]             @relation("UserInvitations")
  kardexEntries            Kardex[]
  maintenances             Maintenance[]
  resolvedMaintenances     Maintenance[]            @relation("MaintenanceResolver")
  contacts                 ResidentContact[]        @relation("UserContacts")
  residentProfile          ResidentProfile?
  rounds                   Round[]                  @relation("GuardRounds")
  property                 Property?                @relation(fields: [propertyId], references: [id])
  recurringConfiguration   RecurringConfiguration?  @relation(fields: [recurringConfigurationId], references: [id])
  role                     Role                     @relation(fields: [roleId], references: [id])
  schedule                 Schedule?                @relation(fields: [scheduleId], references: [id])
  recurringConfigurations  RecurringConfiguration[] @relation("RecurringAssignments")
  chatMessages             ChatMessage[]            @relation("ChatMessages")
  createdShiftHandovers    ShiftHandover[]          @relation("ShiftHandoverCreator")
  shiftHandoverAppearances ShiftHandoverElement[]   @relation("ShiftHandoverGuard")
  uniformChecksReceived    UniformCheck[]           @relation("UniformGuard")
  uniformChecksPerformed   UniformCheck[]           @relation("UniformEvaluator")
  mediaFiles               MediaFile[]
  person                   Person?
  notifications            Notification[]
  auditLogs                AuditLog[]
  pushDevices              PushDevice[]

  @@index([roleId])
  @@index([isLoggedIn])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Property {
  id             Int            @id @default(autoincrement())
  identifier     String         @unique
  name           String
  mainStreet     String
  betweenStreets String?
  latitude       Float?
  longitude      Float?
  active         Boolean        @default(true)
  softDelete     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  statusId       Int
  typeId         Int
  invitations    Invitation[]
  status         PropertyStatus @relation(fields: [statusId], references: [id])
  type           PropertyType   @relation(fields: [typeId], references: [id])
  users          User[]

  // A1: tipo, ocupación y residentes (T-A1-02). `statusId`/`typeId` quedan por compatibilidad.
  kindId            Int
  kind              PropertyKind      @relation(fields: [kindId], references: [id])
  buildingId        Int?
  building          Building?         @relation(fields: [buildingId], references: [id])
  floor             Int?
  unitNumber        String?
  occupancyStatusId Int
  occupancyStatus   OccupancyStatus   @relation(fields: [occupancyStatusId], references: [id])
  residentCount     Int               @default(0)
  maxResidents      Int?
  vehicleQuota      Int?
  ownerPersonId     Int?
  owner             Person?           @relation("PropertyOwner", fields: [ownerPersonId], references: [id])
  periods           OccupancyPeriod[]
  ownershipChanges  OwnershipChange[]
  residents         Resident[]

  @@index([identifier])
  @@index([statusId, typeId])
  @@index([occupancyStatusId])
}

/// Tipo de unidad (casa, departamento, terreno…). Administrable (T-A1-01).
model PropertyKind {
  id              Int        @id @default(autoincrement())
  code            String     @unique
  name            String
  isUnitContainer Boolean    @default(false)
  active          Boolean    @default(true)
  isSystem        Boolean    @default(true)
  order           Int        @default(0)
  properties      Property[]
}

/// Estado de ocupación (vacía, habitada por propietario, rentada…). Solo el servicio de
/// ocupación lo cambia, y solo por transiciones de OccupancyStatusTransition (T-A1-01).
model OccupancyStatus {
  id              Int                         @id @default(autoincrement())
  code            String                      @unique
  name            String
  isOccupied      Boolean                     @default(false)
  allowsResidents Boolean                     @default(false)
  active          Boolean                     @default(true)
  isSystem        Boolean                     @default(true)
  order           Int                         @default(0)
  properties      Property[]
  periods         OccupancyPeriod[]
  fromTransitions OccupancyStatusTransition[] @relation("TransitionFrom")
  toTransitions   OccupancyStatusTransition[] @relation("TransitionTo")
}

model OccupancyStatusTransition {
  fromId     Int
  toId       Int
  fromStatus OccupancyStatus @relation("TransitionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toStatus   OccupancyStatus @relation("TransitionTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

/// Edificio de departamentos (T-A1-02).
model Building {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  floors     Int?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  properties Property[]
}

/// Persona (propietario, inquilino). Se amplía en A2 (T-A1-02, ADR-016: Persona ≠ Residente ≠ Usuario).
model Person {
  id              Int               @id @default(autoincrement())
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  birthDate       DateTime?         @db.Date
  userId          Int?              @unique
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  residents       Resident[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ownedProperties Property[]        @relation("PropertyOwner")
  ownerPeriods    OccupancyPeriod[] @relation("PeriodOwner")
  tenantPeriods   OccupancyPeriod[] @relation("PeriodTenant")
  ownershipFrom   OwnershipChange[] @relation("OwnershipFrom")
  ownershipTo     OwnershipChange[] @relation("OwnershipTo")
}

/// Tipo de residente (T-A2-01). `isHouseholdMember` decide si suma al conteo del hogar.
model ResidentKind {
  id                 Int        @id @default(autoincrement())
  code               String     @unique
  name               String
  isHouseholdMember  Boolean    @default(false)
  canAuthorizeVisits Boolean    @default(false)
  canHaveVehicle     Boolean    @default(false)
  hasAppAccess       Boolean    @default(false)
  active             Boolean    @default(true)
  isSystem           Boolean    @default(true)
  order              Int        @default(0)
  residents          Resident[]
}

enum ResidentStatus {
  ACTIVE
  MOVED_OUT
}

/// Vínculo de una persona con una propiedad (T-A2-01). Reemplaza a User.propertyId como
/// fuente de verdad del hogar; User.propertyId se mantiene sincronizado mientras dura la transición.
model Resident {
  id                 Int            @id @default(autoincrement())
  personId           Int
  propertyId         Int
  kindId             Int
  status             ResidentStatus @default(ACTIVE)
  isPrimary          Boolean        @default(false)
  canAuthorizeVisits Boolean        @default(false)
  hasAppAccess       Boolean        @default(false)
  startDate          DateTime       @db.Date
  endDate            DateTime?      @db.Date
  notes              String?
  createdAt          DateTime       @default(now())
  person             Person         @relation(fields: [personId], references: [id])
  property           Property       @relation(fields: [propertyId], references: [id])
  kind               ResidentKind   @relation(fields: [kindId], references: [id])

  @@index([propertyId, status])
  @@index([personId])
}

/// Periodo de ocupación. Un solo periodo vigente por propiedad (índice parcial en la migración,
/// T-A1-03). El historial se conserva al cerrar periodos.
model OccupancyPeriod {
  id             Int             @id @default(autoincrement())
  propertyId     Int
  statusId       Int
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  tenantPersonId Int?
  ownerPersonId  Int?
  notes          String?
  createdById    Int?
  createdAt      DateTime        @default(now())
  property       Property        @relation(fields: [propertyId], references: [id])
  status         OccupancyStatus @relation(fields: [statusId], references: [id])
  tenant         Person?         @relation("PeriodTenant", fields: [tenantPersonId], references: [id])
  owner          Person?         @relation("PeriodOwner", fields: [ownerPersonId], references: [id])

  @@index([propertyId, startDate])
}

/// Cambio de propietario, separado de la ocupación (T-A1-05).
model OwnershipChange {
  id           Int      @id @default(autoincrement())
  propertyId   Int
  fromPersonId Int?
  toPersonId   Int
  changedById  Int?
  changedAt    DateTime @default(now())
  notes        String?
  property     Property @relation(fields: [propertyId], references: [id])
  fromPerson   Person?  @relation("OwnershipFrom", fields: [fromPersonId], references: [id])
  toPerson     Person   @relation("OwnershipTo", fields: [toPersonId], references: [id])

  @@index([propertyId])
}

model ResidentProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  firstName        String?
  fatherLastName   String?
  motherLastName   String?
  phoneNumber      String?
  email            String?
  ineFrontUrl      String?
  ineBackUrl       String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model Invitation {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  guestName   String
  createdById Int
  propertyId  Int
  validFrom   DateTime
  validUntil  DateTime
  status      InvitationStatus @default(PENDING)
  entryTime   DateTime?
  exitTime    DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  typeId      Int
  createdBy   User             @relation("UserInvitations", fields: [createdById], references: [id])
  property    Property         @relation(fields: [propertyId], references: [id])
  type        InvitationType   @relation(fields: [typeId], references: [id])

  statusId                Int?
  invitationStatusCatalog InvitationStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([code])
  @@index([propertyId, status])
}

model Location {
  id                 Int                 @id @default(autoincrement())
  aisle              String
  spot               String
  number             String
  name               String              @unique
  isOccupied         Boolean             @default(false)
  active             Boolean             @default(true)
  softDelete         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  kardexEntries      Kardex[]
  recurringLocations RecurringLocation[]
}

model Kardex {
  id           Int         @id @default(autoincrement())
  userId       Int
  locationId   Int
  timestamp    DateTime    @default(now())
  notes        String?
  media        Json?
  latitude     Float?
  longitude    Float?
  assignmentId Int?
  scanType     ScanType    @default(FREE)
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  location     Location    @relation(fields: [locationId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  scanTypeId      Int?
  scanTypeCatalog ScanTypeCatalog? @relation(fields: [scanTypeId], references: [id])

  @@index([userId])
  @@index([locationId])
  @@index([timestamp])
  @@index([userId, timestamp(sort: Desc)])
}

model Assignment {
  id         Int              @id @default(autoincrement())
  guardId    Int
  locationId Int
  status     AssignmentStatus @default(PENDING)
  assignedBy Int
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  guard      User             @relation("GuardAssignments", fields: [guardId], references: [id])
  location   Location         @relation(fields: [locationId], references: [id])
  tasks      AssignmentTask[]
  kardex     Kardex[]

  statusId                Int?
  assignmentStatusCatalog AssignmentStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([guardId])
  @@index([locationId])
}

model AssignmentTask {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  description  String
  reqPhoto     Boolean    @default(false)
  completed    Boolean    @default(false)
  completedAt  DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
}

model RecurringConfiguration {
  id                 Int                 @id @default(autoincrement())
  title              String
  description        String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recurringLocations RecurringLocation[]
  rounds             Round[]
  users              User[]
  guards             User[]              @relation("RecurringAssignments")
}

model RecurringLocation {
  id              Int                    @id @default(autoincrement())
  locationId      Int
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  configurationId Int
  configuration   RecurringConfiguration @relation(fields: [configurationId], references: [id])
  location        Location               @relation(fields: [locationId], references: [id])
  tasks           RecurringTask[]

  @@index([configurationId])
}

model RecurringTask {
  id                  Int               @id @default(autoincrement())
  recurringLocationId Int
  description         String
  reqPhoto            Boolean           @default(false)
  recurringLocation   RecurringLocation @relation(fields: [recurringLocationId], references: [id])
}

model IncidentCategory {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  value        String
  color        String?
  icon         String?
  type         String         @default("INCIDENT")
  isSystem     Boolean        @default(false)
  active       Boolean        @default(true)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  incidents    Incident[]
  types        IncidentType[]
  maintenances Maintenance[]
}

model IncidentType {
  id           Int              @id @default(autoincrement())
  categoryId   Int
  name         String           @unique
  value        String
  isSystem     Boolean          @default(false)
  active       Boolean          @default(true)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  incidents    Incident[]
  category     IncidentCategory @relation(fields: [categoryId], references: [id])
  maintenances Maintenance[]
}

model Incident {
  id           Int               @id @default(autoincrement())
  guardId      Int
  kind         String            @default("INCIDENT")
  title        String
  description  String?
  media        Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  resolvedAt   DateTime?
  resolvedById Int?
  status       IncidentStatus    @default(PENDING)
  categoryId   Int?
  typeId       Int?
  latitude     Float?
  longitude    Float?
  clientRef    String?           @unique
  category     IncidentCategory? @relation(fields: [categoryId], references: [id])
  guard        User              @relation(fields: [guardId], references: [id])
  resolvedBy   User?             @relation("IncidentResolver", fields: [resolvedById], references: [id])
  type         IncidentType?     @relation(fields: [typeId], references: [id])

  statusId              Int?
  incidentStatusCatalog IncidentStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([kind, status, createdAt(sort: Desc)])
}

model Round {
  id                       Int                     @id @default(autoincrement())
  guardId                  Int
  startTime                DateTime                @default(now())
  endTime                  DateTime?
  status                   RoundStatus             @default(IN_PROGRESS)
  recurringConfigurationId Int?
  guard                    User                    @relation("GuardRounds", fields: [guardId], references: [id])
  recurringConfiguration   RecurringConfiguration? @relation(fields: [recurringConfigurationId], references: [id])

  statusId           Int?
  roundStatusCatalog RoundStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([guardId, status])
  @@index([recurringConfigurationId, status])
  @@index([startTime(sort: Desc)])
}

model AppSetting {
  key         String   @id
  valueType   String   @default("string")
  value       String
  group       String   @default("general")
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Bitácora de cambios administrativos (T-F0-12). Solo se agrega; nunca se edita.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum OutboxStatus {
  PENDING
  SENT
  DEAD
}

/// Evento a entregar con reintentos (T-F0-10). DEAD = agotó los intentos.
model OutboxEvent {
  id            Int            @id @default(autoincrement())
  type          String
  payload       Json
  status        OutboxStatus   @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  createdAt     DateTime       @default(now())
  sentAt        DateTime?
  notifications Notification[]

  @@index([status, nextAttemptAt])
}

model Notification {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outboxEventId Int?
  outboxEvent   OutboxEvent? @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)
  title         String
  body          String
  data          Json?
  createdAt     DateTime     @default(now())
  readAt        DateTime?

  @@unique([outboxEventId, userId])
  @@index([userId, readAt])
}

model PushDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
}

enum MediaFileStatus {
  PENDING
  CONFIRMED
}

/// Archivo subido directo a S3 con URL prefirmada (T-F0-09).
model MediaFile {
  id           Int             @id @default(autoincrement())
  key          String          @unique
  contentType  String
  sizeBytes    Int
  status       MediaFileStatus @default(PENDING)
  uploadedById Int?
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  confirmedAt  DateTime?

  @@index([uploadedById])
}

model SysConfig {
  key   String @id
  value String
}

model Maintenance {
  id           Int               @id @default(autoincrement())
  guardId      Int
  title        String
  category     String?
  description  String?
  media        Json?
  status       MaintenanceStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  latitude     Float?
  longitude    Float?
  categoryId   Int?
  typeId       Int?
  categoryRel  IncidentCategory? @relation(fields: [categoryId], references: [id])
  guard        User              @relation(fields: [guardId], references: [id])
  resolvedBy   User?             @relation("MaintenanceResolver", fields: [resolvedById], references: [id])
  type         IncidentType?     @relation(fields: [typeId], references: [id])

  statusId                 Int?
  maintenanceStatusCatalog MaintenanceStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([status, createdAt(sort: Desc)])
}

model ResidentContact {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  phone        String?
  email        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  relationship String?
  user         User     @relation("UserContacts", fields: [userId], references: [id])
}

model ResidentRelationship {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
  order     Int      @default(0)
  isSystem  Boolean  @default(false)
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  createdAt DateTime @default(now())
  user      User     @relation("ChatMessages", fields: [userId], references: [id])

  @@index([createdAt])
}

model ShiftHandover {
  id                 Int                    @id @default(autoincrement())
  shiftType          ShiftType
  handoverDate       DateTime               @db.Date
  credentialsCount   Int?
  tarjetonesCount    Int?
  novedades          String?
  checklistPhones    Boolean                @default(false)
  checklistTablet    Boolean                @default(false)
  checklistRadios    Boolean                @default(false)
  checklistKeys      Boolean                @default(false)
  checklistLogbook   Boolean                @default(false)
  checklistConsignas Boolean                @default(false)
  reportedToAdmin    Boolean                @default(false)
  createdById        Int
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdBy          User                   @relation("ShiftHandoverCreator", fields: [createdById], references: [id])
  elements           ShiftHandoverElement[]

  checks ShiftHandoverCheck[]

  @@unique([shiftType, handoverDate])
  @@index([handoverDate])
}

model ShiftHandoverElement {
  id              Int           @id @default(autoincrement())
  shiftHandoverId Int
  guardId         Int
  entryTime       String
  punctual        Boolean       @default(true)
  observations    String?
  shiftHandover   ShiftHandover @relation(fields: [shiftHandoverId], references: [id])
  guard           User          @relation("ShiftHandoverGuard", fields: [guardId], references: [id])

  @@index([shiftHandoverId])
  @@index([guardId])
}

model UniformCheck {
  id            Int      @id @default(autoincrement())
  guardId       Int
  evaluatedById Int
  pantalon      Boolean  @default(false)
  botas         Boolean  @default(false)
  cinturon      Boolean  @default(false)
  camisa        Boolean  @default(false)
  pluma         Boolean  @default(false)
  gorra         Boolean  @default(false)
  unas          Boolean  @default(false)
  orejas        Boolean  @default(false)
  desodorante   Boolean  @default(false)
  afeitado      Boolean  @default(false)
  peinado       Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  guard         User     @relation("UniformGuard", fields: [guardId], references: [id])
  evaluatedBy   User     @relation("UniformEvaluator", fields: [evaluatedById], references: [id])

  items UniformCheckItem[]

  @@index([createdAt])
  @@index([guardId])
}

enum AssignmentStatus {
  PENDING
  CHECKING
  UNDER_REVIEW
  REVIEWED
  ANOMALY
}

enum InvitationStatus {
  PENDING
  ENTERED
  EXITED
  EXPIRED
  CANCELLED
}

enum ScanType {
  ASSIGNMENT
  RECURRING
  FREE
}

enum IncidentStatus {
  PENDING
  ATTENDED
}

enum RoundStatus {
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceStatus {
  PENDING
  ATTENDED
}

enum ShiftType {
  MATUTINO
  NOCTURNO
}

/// Catálogo de AssignmentStatus (T-F0-13): la columna enum sigue vigente; esta FK se llena en doble escritura.
