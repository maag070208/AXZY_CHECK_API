generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  value       String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PropertyType {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  value      String
  properties Property[]
  active     Boolean    @default(true)
  order      Int        @default(0)
  isSystem   Boolean    @default(false)
}

model PropertyStatus {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  value      String
  properties Property[]
  active     Boolean    @default(true)
  order      Int        @default(0)
  isSystem   Boolean    @default(false)
}

model InvitationType {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  value       String
  invitations Invitation[]
  active      Boolean      @default(true)
  order       Int          @default(0)
  isSystem    Boolean      @default(false)
}

model User {
  complaintsAuthored       Complaint[]              @relation("ComplaintAuthor")
  complaintsAssigned       Complaint[]              @relation("ComplaintAssignee")
  accessEventsAsGuard      AccessEvent[]            @relation("AccessEventGuard")
  accessExceptionsCreated  AccessException[]        @relation("AccessExceptionCreator")
  delinquencyRulesUpdated  DelinquencyRule[]        @relation("DelinquencyRuleUpdater")
  complaintMessages        ComplaintMessage[]
  complaintEvents          ComplaintEvent[]
  chargesAsResident        Charge[]                 @relation("ResidentCharges")
  chargesCreated           Charge[]                 @relation("ChargeCreator")
  paymentsAsResident       Payment[]                @relation("PaymentResident")
  paymentsRegistered       Payment[]                @relation("PaymentRegistrar")
  paymentsVoided           Payment[]                @relation("PaymentVoider")
  id                       Int                      @id @default(autoincrement())
  name                     String
  lastName                 String?
  username                 String                   @unique
  password                 String
  active                   Boolean                  @default(true)
  /// Se incrementa para revocar todas las sesiones del usuario (logout, cambio o reinicio de contraseña).
  tokenVersion             Int                      @default(0)
  /// Bloqueo temporal por intentos fallidos de inicio de sesión.
  failedLoginCount         Int                      @default(0)
  lockedUntil              DateTime?
  softDelete               Boolean                  @default(false)
  shiftStart               String?
  shiftEnd                 String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  isLoggedIn               Boolean                  @default(false)
  photoUrl                 String?
  photoKey                 String?
  recurringConfigurationId Int?
  scheduleId               Int?
  propertyId               Int?
  roleId                   Int
  assignments              Assignment[]             @relation("GuardAssignments")
  incidents                Incident[]
  resolvedIncidents        Incident[]               @relation("IncidentResolver")
  invitationsCreated       Invitation[]             @relation("UserInvitations")
  kardexEntries            Kardex[]
  maintenances             Maintenance[]
  resolvedMaintenances     Maintenance[]            @relation("MaintenanceResolver")
  contacts                 ResidentContact[]        @relation("UserContacts")
  residentProfile          ResidentProfile?
  rounds                   Round[]                  @relation("GuardRounds")
  property                 Property?                @relation(fields: [propertyId], references: [id])
  recurringConfiguration   RecurringConfiguration?  @relation(fields: [recurringConfigurationId], references: [id])
  role                     Role                     @relation(fields: [roleId], references: [id])
  refreshTokens            RefreshToken[]
  schedule                 Schedule?                @relation(fields: [scheduleId], references: [id])
  recurringConfigurations  RecurringConfiguration[] @relation("RecurringAssignments")
  chatMessages             ChatMessage[]            @relation("ChatMessages")
  createdShiftHandovers    ShiftHandover[]          @relation("ShiftHandoverCreator")
  shiftHandoverAppearances ShiftHandoverElement[]   @relation("ShiftHandoverGuard")
  uniformChecksReceived    UniformCheck[]           @relation("UniformGuard")
  uniformChecksPerformed   UniformCheck[]           @relation("UniformEvaluator")
  mediaFiles               MediaFile[]
  person                   Person?
  notifications            Notification[]
  announcementsCreated     Announcement[]           @relation("AnnouncementCreator")
  vehiclesOwned            Vehicle[]                @relation("VehicleOwner")
  vehiclesApproved         Vehicle[]                @relation("VehicleApprover")
  accessPins               AccessPin[]              @relation("AccessPinOwner")
  personalQrPasses         PersonalQrPass[]
  accessPinsCreated        AccessPin[]              @relation("AccessPinCreator")
  auditLogs                AuditLog[]
  pushDevices              PushDevice[]

  @@index([roleId])
  @@index([propertyId])
  @@index([isLoggedIn])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Property {
  complaints       Complaint[]
  charges          Charge[]
  payments         Payment[]
  incidents        Incident[]
  collectionConfig CollectionConfig?
  accessEvents     AccessEvent[]
  accessExceptions AccessException[]
  announcements    Announcement[]    @relation("AnnouncementProperty")
  vehicles         Vehicle[]
  accessPins       AccessPin[]
  personalQrPasses PersonalQrPass[]
  id               Int               @id @default(autoincrement())
  identifier       String            @unique
  name             String
  mainStreet       String
  betweenStreets   String?
  latitude         Float?
  longitude        Float?
  active           Boolean           @default(true)
  softDelete       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  statusId         Int
  typeId           Int
  invitations      Invitation[]
  status           PropertyStatus    @relation(fields: [statusId], references: [id])
  type             PropertyType      @relation(fields: [typeId], references: [id])
  users            User[]

  // A1: tipo, ocupación y residentes (T-A1-02). `statusId`/`typeId` quedan por compatibilidad.
  kindId            Int
  kind              PropertyKind            @relation(fields: [kindId], references: [id])
  buildingId        Int?
  building          Building?               @relation(fields: [buildingId], references: [id])
  floor             Int?
  unitNumber        String?
  occupancyStatusId Int
  occupancyStatus   OccupancyStatus         @relation(fields: [occupancyStatusId], references: [id])
  residentCount     Int                     @default(0)
  maxResidents      Int?
  vehicleQuota      Int?
  ownerPersonId     Int?
  owner             Person?                 @relation("PropertyOwner", fields: [ownerPersonId], references: [id])
  periods           OccupancyPeriod[]
  ownershipChanges  OwnershipChange[]
  residents         Resident[]
  authorizations    PropertyAuthorization[]

  @@index([identifier])
  @@index([statusId, typeId])
  @@index([softDelete, active])
  @@index([occupancyStatusId])
}

/// Tipo de unidad (casa, departamento, terreno…). Administrable (T-A1-01).
model PropertyKind {
  id              Int        @id @default(autoincrement())
  code            String     @unique
  name            String
  isUnitContainer Boolean    @default(false)
  active          Boolean    @default(true)
  isSystem        Boolean    @default(true)
  order           Int        @default(0)
  properties      Property[]
}

/// Estado de ocupación (vacía, habitada por propietario, rentada…). Solo el servicio de
/// ocupación lo cambia, y solo por transiciones de OccupancyStatusTransition (T-A1-01).
model OccupancyStatus {
  id              Int                         @id @default(autoincrement())
  code            String                      @unique
  name            String
  isOccupied      Boolean                     @default(false)
  allowsResidents Boolean                     @default(false)
  active          Boolean                     @default(true)
  isSystem        Boolean                     @default(true)
  order           Int                         @default(0)
  properties      Property[]
  periods         OccupancyPeriod[]
  fromTransitions OccupancyStatusTransition[] @relation("TransitionFrom")
  toTransitions   OccupancyStatusTransition[] @relation("TransitionTo")
}

model OccupancyStatusTransition {
  fromId     Int
  toId       Int
  fromStatus OccupancyStatus @relation("TransitionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toStatus   OccupancyStatus @relation("TransitionTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

/// Edificio de departamentos (T-A1-02).
model Building {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  floors     Int?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  properties Property[]
}

/// Persona (propietario, inquilino). Se amplía en A2 (T-A1-02, ADR-016: Persona ≠ Residente ≠ Usuario).
model Person {
  id              Int                     @id @default(autoincrement())
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  birthDate       DateTime?               @db.Date
  userId          Int?                    @unique
  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  residents       Resident[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  ownedProperties Property[]              @relation("PropertyOwner")
  ownerPeriods    OccupancyPeriod[]       @relation("PeriodOwner")
  tenantPeriods   OccupancyPeriod[]       @relation("PeriodTenant")
  ownershipFrom   OwnershipChange[]       @relation("OwnershipFrom")
  ownershipTo     OwnershipChange[]       @relation("OwnershipTo")
  contacts        PersonContact[]
  documents       PersonDocument[]
  authorizations  PropertyAuthorization[]
  accessEvents    AccessEvent[]           @relation("AccessEventPerson")
}

/// Tipo de residente (T-A2-01). `isHouseholdMember` decide si suma al conteo del hogar.
model ResidentKind {
  id                 Int        @id @default(autoincrement())
  code               String     @unique
  name               String
  isHouseholdMember  Boolean    @default(false)
  canAuthorizeVisits Boolean    @default(false)
  canHaveVehicle     Boolean    @default(false)
  hasAppAccess       Boolean    @default(false)
  active             Boolean    @default(true)
  isSystem           Boolean    @default(true)
  order              Int        @default(0)
  residents          Resident[]
}

enum ResidentStatus {
  ACTIVE
  MOVED_OUT
}

/// Vínculo de una persona con una propiedad (T-A2-01). Reemplaza a User.propertyId como
/// fuente de verdad del hogar; User.propertyId se mantiene sincronizado mientras dura la transición.
model Resident {
  id                 Int            @id @default(autoincrement())
  personId           Int
  propertyId         Int
  kindId             Int
  status             ResidentStatus @default(ACTIVE)
  isPrimary          Boolean        @default(false)
  canAuthorizeVisits Boolean        @default(false)
  hasAppAccess       Boolean        @default(false)
  startDate          DateTime       @db.Date
  endDate            DateTime?      @db.Date
  notes              String?
  createdAt          DateTime       @default(now())
  person             Person         @relation(fields: [personId], references: [id])
  property           Property       @relation(fields: [propertyId], references: [id])
  kind               ResidentKind   @relation(fields: [kindId], references: [id])

  @@index([propertyId, status])
  @@index([personId])
}

/// Periodo de ocupación. Un solo periodo vigente por propiedad (índice parcial en la migración,
/// T-A1-03). El historial se conserva al cerrar periodos.
model OccupancyPeriod {
  id             Int             @id @default(autoincrement())
  propertyId     Int
  statusId       Int
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  tenantPersonId Int?
  ownerPersonId  Int?
  notes          String?
  createdById    Int?
  createdAt      DateTime        @default(now())
  property       Property        @relation(fields: [propertyId], references: [id])
  status         OccupancyStatus @relation(fields: [statusId], references: [id])
  tenant         Person?         @relation("PeriodTenant", fields: [tenantPersonId], references: [id])
  owner          Person?         @relation("PeriodOwner", fields: [ownerPersonId], references: [id])

  @@index([propertyId, startDate])
}

/// Cambio de propietario, separado de la ocupación (T-A1-05).
model OwnershipChange {
  id           Int      @id @default(autoincrement())
  propertyId   Int
  fromPersonId Int?
  toPersonId   Int
  changedById  Int?
  changedAt    DateTime @default(now())
  notes        String?
  property     Property @relation(fields: [propertyId], references: [id])
  fromPerson   Person?  @relation("OwnershipFrom", fields: [fromPersonId], references: [id])
  toPerson     Person   @relation("OwnershipTo", fields: [toPersonId], references: [id])

  @@index([propertyId])
}

model ResidentProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  firstName        String?
  fatherLastName   String?
  motherLastName   String?
  phoneNumber      String?
  email            String?
  ineFrontUrl      String?
  ineBackUrl       String?
  photoUrl         String?
  photoKey         String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model Invitation {
  id           Int              @id @default(autoincrement())
  code         String           @unique
  guestName    String
  createdById  Int
  propertyId   Int
  validFrom    DateTime
  validUntil   DateTime
  status       InvitationStatus @default(PENDING)
  entryTime    DateTime?
  exitTime     DateTime?
  notes        String?
  revokedReason String?
  revokedAt    DateTime?
  revokedById  Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  typeId       Int
  createdBy    User             @relation("UserInvitations", fields: [createdById], references: [id])
  property     Property         @relation(fields: [propertyId], references: [id])
  type         InvitationType   @relation(fields: [typeId], references: [id])
  accessEvents AccessEvent[]

  statusId                Int?
  invitationStatusCatalog InvitationStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([code])
  @@index([propertyId, status])
}

model Location {
  id                 Int                 @id @default(autoincrement())
  aisle              String
  spot               String
  number             String
  name               String              @unique
  isOccupied         Boolean             @default(false)
  active             Boolean             @default(true)
  softDelete         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  kardexEntries      Kardex[]
  recurringLocations RecurringLocation[]
}

model Kardex {
  id             Int         @id @default(autoincrement())
  userId         Int
  locationId     Int
  timestamp      DateTime    @default(now())
  notes          String?
  media          Json?
  latitude       Float?
  longitude      Float?
  assignmentId   Int?
  clientRef      String?     @unique
  roundId        Int?
  createdOffline Boolean     @default(false)
  syncedAt       DateTime?
  scanType       ScanType    @default(FREE)
  assignment     Assignment? @relation(fields: [assignmentId], references: [id])
  round          Round?      @relation(fields: [roundId], references: [id])
  location       Location    @relation(fields: [locationId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  scanTypeId      Int?
  scanTypeCatalog ScanTypeCatalog? @relation(fields: [scanTypeId], references: [id])

  @@index([userId])
  @@index([locationId])
  @@index([timestamp])
  @@index([userId, timestamp(sort: Desc)])
  @@index([roundId])
}

model Assignment {
  id         Int              @id @default(autoincrement())
  guardId    Int
  locationId Int
  status     AssignmentStatus @default(PENDING)
  assignedBy Int
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  guard      User             @relation("GuardAssignments", fields: [guardId], references: [id])
  location   Location         @relation(fields: [locationId], references: [id])
  tasks      AssignmentTask[]
  kardex     Kardex[]

  statusId                Int?
  assignmentStatusCatalog AssignmentStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([guardId])
  @@index([locationId])
}

model AssignmentTask {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  description  String
  reqPhoto     Boolean    @default(false)
  completed    Boolean    @default(false)
  completedAt  DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
}

model RecurringConfiguration {
  id                 Int                 @id @default(autoincrement())
  title              String
  description        String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recurringLocations RecurringLocation[]
  rounds             Round[]
  users              User[]
  guards             User[]              @relation("RecurringAssignments")
}

model RecurringLocation {
  id              Int                    @id @default(autoincrement())
  locationId      Int
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  configurationId Int
  configuration   RecurringConfiguration @relation(fields: [configurationId], references: [id])
  location        Location               @relation(fields: [locationId], references: [id])
  tasks           RecurringTask[]

  @@index([configurationId])
}

model RecurringTask {
  id                  Int               @id @default(autoincrement())
  recurringLocationId Int
  description         String
  reqPhoto            Boolean           @default(false)
  recurringLocation   RecurringLocation @relation(fields: [recurringLocationId], references: [id])
}

model IncidentCategory {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  value        String
  color        String?
  icon         String?
  type         String         @default("INCIDENT")
  isSystem     Boolean        @default(false)
  active       Boolean        @default(true)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  incidents    Incident[]
  types        IncidentType[]
  maintenances Maintenance[]
}

model IncidentType {
  id           Int              @id @default(autoincrement())
  categoryId   Int
  name         String           @unique
  value        String
  isSystem     Boolean          @default(false)
  active       Boolean          @default(true)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  incidents    Incident[]
  category     IncidentCategory @relation(fields: [categoryId], references: [id])
  maintenances Maintenance[]
}

model Incident {
  id             Int               @id @default(autoincrement())
  guardId        Int
  propertyId     Int?
  kind           String            @default("INCIDENT")
  title          String
  description    String?
  media          Json?
  createdOffline Boolean           @default(false)
  syncedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resolvedAt     DateTime?
  resolvedById   Int?
  status         IncidentStatus    @default(PENDING)
  categoryId     Int?
  typeId         Int?
  latitude       Float?
  longitude      Float?
  clientRef      String?           @unique
  category       IncidentCategory? @relation(fields: [categoryId], references: [id])
  property       Property?         @relation(fields: [propertyId], references: [id])
  guard          User              @relation(fields: [guardId], references: [id])
  resolvedBy     User?             @relation("IncidentResolver", fields: [resolvedById], references: [id])
  type           IncidentType?     @relation(fields: [typeId], references: [id])

  statusId              Int?
  incidentStatusCatalog IncidentStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([kind, status, createdAt(sort: Desc)])
  @@index([propertyId, createdAt(sort: Desc)])
}

/// Buzón de quejas del residente (módulo 13). Siempre identificadas: `authorId` obligatorio.
enum ComplaintCategory {
  MANTENIMIENTO
  SEGURIDAD
  RUIDO
  LIMPIEZA
  ADMINISTRACION
  SUGERENCIA
  OTRA
}

enum ComplaintStatus {
  NEW
  IN_REVIEW
  WAITING_RESIDENT
  RESOLVED
  CLOSED
  REOPENED
}

model Complaint {
  id           Int                @id @default(autoincrement())
  propertyId   Int
  authorId     Int
  assignedToId Int?
  category     ComplaintCategory
  title        String
  description  String
  media        Json?
  status       ComplaintStatus    @default(NEW)
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  property     Property           @relation(fields: [propertyId], references: [id])
  author       User               @relation("ComplaintAuthor", fields: [authorId], references: [id])
  assignedTo   User?              @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  messages     ComplaintMessage[]
  events       ComplaintEvent[]

  @@index([propertyId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, resolvedAt])
}

model ComplaintMessage {
  id          Int       @id @default(autoincrement())
  complaintId Int
  authorId    Int
  body        String
  /// Nota interna del personal: nunca se devuelve al residente.
  internal    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  author      User      @relation(fields: [authorId], references: [id])

  @@index([complaintId, createdAt])
}

model ComplaintEvent {
  id          Int              @id @default(autoincrement())
  complaintId Int
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  /// null = transición automática del sistema (p. ej. cierre a los 7 días).
  byUserId    Int?
  createdAt   DateTime         @default(now())
  complaint   Complaint        @relation(fields: [complaintId], references: [id])
  byUser      User?            @relation(fields: [byUserId], references: [id])

  @@index([complaintId, createdAt])
}

/// Cargos del residente (módulo 13, pagos). Un cargo pertenece a una propiedad
/// y se asigna al residente titular (`User` con rol RESDN) que debe pagarlo.
enum ChargeCategory {
  CUOTA
  MANTENIMIENTO
  EXTRA
  RECARGO
  MULTA
}

/// Periodicidad de la cuota de cobranza. Los meses se suman a `nextChargeDate`.
enum CollectionFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  FOUR_MONTHLY
  SEMIANNUAL
  ANNUAL
}

enum LateFeeType {
  NONE
  FIXED
  PERCENT
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  AJUSTE
}

model Charge {
  id              Int                 @id @default(autoincrement())
  propertyId      Int
  residentId      Int
  concept         String
  category        ChargeCategory      @default(EXTRA)
  amount          Decimal             @db.Decimal(10, 2)
  dueDate         DateTime            @db.Date
  status          ChargeStatus        @default(PENDING)
  /// Periodo YYYY-MM. Solo para CUOTA; la combinación propertyId+period es única.
  period          String?
  notes           String?
  createdById     Int
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  property        Property            @relation(fields: [propertyId], references: [id])
  resident        User                @relation("ResidentCharges", fields: [residentId], references: [id])
  createdBy       User                @relation("ChargeCreator", fields: [createdById], references: [id])
  allocations     PaymentAllocation[]
  /// Cargo original que generó este recargo. Evita recargos duplicados.
  sourceChargeId  Int?                @unique
  sourceCharge    Charge?             @relation("ChargeRecargo", fields: [sourceChargeId], references: [id], onDelete: SetNull)
  recargos        Charge[]            @relation("ChargeRecargo")

  /// Cuota mensual única por propiedad y periodo (los cargos sin periodo tienen NULL).
  @@unique([propertyId, period])
  @@index([residentId, status, dueDate])
  @@index([propertyId, status])
  @@index([dueDate])
}

/// Configuración de cobranza por propiedad: periodicidad, vencimiento y recargos.
model CollectionConfig {
  id             Int                 @id @default(autoincrement())
  propertyId     Int                 @unique
  property       Property            @relation(fields: [propertyId], references: [id])
  concept        String              @default("Cuota de mantenimiento")
  amount         Decimal             @db.Decimal(10, 2)
  frequency      CollectionFrequency @default(MONTHLY)
  /// Día del mes en que vence la cuota (1-28).
  dueDay         Int                 @default(10)
  /// Fecha del siguiente cargo a generar. Se avanza según `frequency`.
  nextChargeDate DateTime            @db.Date
  graceDays      Int                 @default(5)
  lateFeeType    LateFeeType         @default(NONE)
  lateFeeValue   Decimal             @default(0) @db.Decimal(10, 2)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Payment {
  id                Int                 @id @default(autoincrement())
  propertyId        Int
  /// Residente al que se atribuye el pago cuando se registra en ventanilla.
  residentId        Int?
  amount            Decimal             @db.Decimal(10, 2)
  /// Folio consecutivo por residencial; se asigna al registrar el pago.
  folio             Int?                @unique
  method            PaymentMethod
  reference         String?
  notes             String?
  paidAt            DateTime            @default(now())
  registeredById    Int
  receiptKey        String?
  /// Diferencia no aplicada a cargos (saldo a favor del residente).
  unallocatedAmount Decimal             @default(0) @db.Decimal(10, 2)
  voidedAt          DateTime?
  voidedById        Int?
  voidReason        String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  property          Property            @relation(fields: [propertyId], references: [id])
  resident          User?               @relation("PaymentResident", fields: [residentId], references: [id])
  registeredBy      User                @relation("PaymentRegistrar", fields: [registeredById], references: [id])
  voidedBy          User?               @relation("PaymentVoider", fields: [voidedById], references: [id])
  allocations       PaymentAllocation[]

  @@index([propertyId, paidAt])
  @@index([residentId, paidAt])
  @@index([paidAt])
}

/// Secuencias de documentos (folios). Se bloquea la fila al asignar para evitar huecos/duplicados.
model DocumentSequence {
  key       String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PaymentAllocation {
  id        Int      @id @default(autoincrement())
  paymentId Int
  chargeId  Int
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge    Charge   @relation(fields: [chargeId], references: [id])

  @@index([paymentId])
  @@index([chargeId])
}

model Round {
  id                       Int                     @id @default(autoincrement())
  guardId                  Int
  startTime                DateTime                @default(now())
  endTime                  DateTime?
  createdOffline           Boolean                 @default(false)
  syncedAt                 DateTime?
  status                   RoundStatus             @default(IN_PROGRESS)
  recurringConfigurationId Int?
  clientRef                String?                 @unique
  guard                    User                    @relation("GuardRounds", fields: [guardId], references: [id])
  recurringConfiguration   RecurringConfiguration? @relation(fields: [recurringConfigurationId], references: [id])
  kardex                   Kardex[]

  statusId           Int?
  roundStatusCatalog RoundStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([guardId, status])
  @@index([recurringConfigurationId, status])
  @@index([startTime(sort: Desc)])
}

model AppSetting {
  key         String   @id
  valueType   String   @default("string")
  value       String
  group       String   @default("general")
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Bitácora de cambios administrativos (T-F0-12). Solo se agrega; nunca se edita.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum OutboxStatus {
  PENDING
  SENT
  DEAD
}

/// Evento a entregar con reintentos (T-F0-10). DEAD = agotó los intentos.
model OutboxEvent {
  id            Int            @id @default(autoincrement())
  type          String
  payload       Json
  status        OutboxStatus   @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  createdAt     DateTime       @default(now())
  sentAt        DateTime?
  notifications Notification[]

  @@index([status, nextAttemptAt])
}

model Notification {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outboxEventId  Int?
  outboxEvent    OutboxEvent?  @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)
  title          String
  body           String
  data           Json?
  createdAt      DateTime      @default(now())
  readAt         DateTime?
  announcementId Int?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@unique([outboxEventId, userId])
  @@index([userId, readAt])
  @@index([announcementId])
}

model PushDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
}

enum MediaFileStatus {
  PENDING
  CONFIRMED
}

/// Archivo subido directo a S3 con URL prefirmada (T-F0-09).
model MediaFile {
  id           Int             @id @default(autoincrement())
  key          String          @unique
  contentType  String
  sizeBytes    Int
  status       MediaFileStatus @default(PENDING)
  uploadedById Int?
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  confirmedAt  DateTime?
  isPrivate    Boolean         @default(false)
  document     PersonDocument?

  @@index([uploadedById])
}

model SysConfig {
  key   String @id
  value String
}

model Maintenance {
  id             Int               @id @default(autoincrement())
  guardId        Int
  title          String
  category       String?
  description    String?
  media          Json?
  status         MaintenanceStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedById   Int?
  createdOffline Boolean           @default(false)
  syncedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  latitude       Float?
  longitude      Float?
  categoryId     Int?
  typeId         Int?
  clientRef      String?           @unique
  categoryRel    IncidentCategory? @relation(fields: [categoryId], references: [id])
  guard          User              @relation(fields: [guardId], references: [id])
  resolvedBy     User?             @relation("MaintenanceResolver", fields: [resolvedById], references: [id])
  type           IncidentType?     @relation(fields: [typeId], references: [id])

  statusId                 Int?
  maintenanceStatusCatalog MaintenanceStatusCatalog? @relation(fields: [statusId], references: [id])

  @@index([status, createdAt(sort: Desc)])
}

model ResidentContact {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  phone        String?
  email        String?
  active       Boolean  @default(true)
  photoUrl     String?
  photoKey     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  relationship String?
  user         User     @relation("UserContacts", fields: [userId], references: [id])
}

model ResidentRelationship {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
  order     Int      @default(0)
  isSystem  Boolean  @default(false)
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  createdAt DateTime @default(now())
  user      User     @relation("ChatMessages", fields: [userId], references: [id])

  @@index([createdAt])
}

model ShiftHandover {
  id                 Int                    @id @default(autoincrement())
  shiftType          ShiftType
  handoverDate       DateTime               @db.Date
  credentialsCount   Int?
  tarjetonesCount    Int?
  novedades          String?
  checklistPhones    Boolean                @default(false)
  checklistTablet    Boolean                @default(false)
  checklistRadios    Boolean                @default(false)
  checklistKeys      Boolean                @default(false)
  checklistLogbook   Boolean                @default(false)
  checklistConsignas Boolean                @default(false)
  reportedToAdmin    Boolean                @default(false)
  createdById        Int
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdBy          User                   @relation("ShiftHandoverCreator", fields: [createdById], references: [id])
  elements           ShiftHandoverElement[]

  checks ShiftHandoverCheck[]

  @@unique([shiftType, handoverDate])
  @@index([handoverDate])
}

model ShiftHandoverElement {
  id              Int           @id @default(autoincrement())
  shiftHandoverId Int
  guardId         Int
  entryTime       String
  punctual        Boolean       @default(true)
  observations    String?
  shiftHandover   ShiftHandover @relation(fields: [shiftHandoverId], references: [id])
  guard           User          @relation("ShiftHandoverGuard", fields: [guardId], references: [id])

  @@index([shiftHandoverId])
  @@index([guardId])
}

model UniformCheck {
  id            Int      @id @default(autoincrement())
  guardId       Int
  evaluatedById Int
  pantalon      Boolean  @default(false)
  botas         Boolean  @default(false)
  cinturon      Boolean  @default(false)
  camisa        Boolean  @default(false)
  pluma         Boolean  @default(false)
  gorra         Boolean  @default(false)
  unas          Boolean  @default(false)
  orejas        Boolean  @default(false)
  desodorante   Boolean  @default(false)
  afeitado      Boolean  @default(false)
  peinado       Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  guard         User     @relation("UniformGuard", fields: [guardId], references: [id])
  evaluatedBy   User     @relation("UniformEvaluator", fields: [evaluatedById], references: [id])

  items UniformCheckItem[]

  @@index([createdAt])
  @@index([guardId])
}

enum AssignmentStatus {
  PENDING
  CHECKING
  UNDER_REVIEW
  REVIEWED
  ANOMALY
}

enum InvitationStatus {
  PENDING
  ENTERED
  EXITED
  EXPIRED
  CANCELLED
}

enum ScanType {
  ASSIGNMENT
  RECURRING
  FREE
}

enum IncidentStatus {
  PENDING
  ATTENDED
}

enum RoundStatus {
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceStatus {
  PENDING
  ATTENDED
}

enum ShiftType {
  MATUTINO
  NOCTURNO
}

/// Catálogo de AssignmentStatus (T-F0-13): la columna enum sigue vigente; esta FK se llena en doble escritura.
model AssignmentStatusCatalog {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  value       String
  order       Int          @default(0)
  active      Boolean      @default(true)
  isSystem    Boolean      @default(true)
  assignments Assignment[]
}

/// Catálogo de InvitationStatus (T-F0-13): la columna enum sigue vigente; esta FK se llena en doble escritura.
model InvitationStatusCatalog {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  value       String
  order       Int          @default(0)
  active      Boolean      @default(true)
  isSystem    Boolean      @default(true)
  invitations Invitation[]
}

/// Catálogo de ScanType (T-F0-13): la columna enum sigue vigente; esta FK se llena en doble escritura.
model ScanTypeCatalog {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  value    String
  order    Int      @default(0)
  active   Boolean  @default(true)
  isSystem Boolean  @default(true)
  kardexs  Kardex[]
}

/// Catálogo de IncidentStatus (T-F0-13): la columna enum sigue vigente; esta FK se llena en doble escritura.
model IncidentStatusCatalog {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  value     String
  order     Int        @default(0)
  active    Boolean    @default(true)
  isSystem  Boolean    @default(true)
  incidents Incident[]
}

/// Catálogo de RoundStatus (T-F0-13): la columna enum sigue vigente; esta FK se llena en doble escritura.
model RoundStatusCatalog {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  value    String
  order    Int     @default(0)
  active   Boolean @default(true)
  isSystem Boolean @default(true)
  rounds   Round[]
}

/// Catálogo de MaintenanceStatus (T-F0-13): la columna enum sigue vigente; esta FK se llena en doble escritura.
model MaintenanceStatusCatalog {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  value        String
  order        Int           @default(0)
  active       Boolean       @default(true)
  isSystem     Boolean       @default(true)
  maintenances Maintenance[]
}

/// Ítem del checklist de uniforme (T-F0-14). Reemplaza las columnas booleanas de UniformCheck.
model UniformItem {
  id       Int                @id @default(autoincrement())
  name     String             @unique
  value    String
  order    Int                @default(0)
  active   Boolean            @default(true)
  isSystem Boolean            @default(true)
  checks   UniformCheckItem[]
}

model UniformCheckItem {
  uniformCheckId Int
  uniformItemId  Int
  checked        Boolean      @default(false)
  uniformCheck   UniformCheck @relation(fields: [uniformCheckId], references: [id], onDelete: Cascade)
  uniformItem    UniformItem  @relation(fields: [uniformItemId], references: [id])

  @@id([uniformCheckId, uniformItemId])
}

/// Ítem del checklist de entrega de turno (T-F0-14). Reemplaza las columnas booleanas de ShiftHandover.
model HandoverChecklistItem {
  id       Int                  @id @default(autoincrement())
  name     String               @unique
  value    String
  order    Int                  @default(0)
  active   Boolean              @default(true)
  isSystem Boolean              @default(true)
  checks   ShiftHandoverCheck[]
}

model ShiftHandoverCheck {
  shiftHandoverId         Int
  handoverChecklistItemId Int
  checked                 Boolean               @default(false)
  shiftHandover           ShiftHandover         @relation(fields: [shiftHandoverId], references: [id], onDelete: Cascade)
  handoverChecklistItem   HandoverChecklistItem @relation(fields: [handoverChecklistItemId], references: [id])

  @@id([shiftHandoverId, handoverChecklistItemId])
}

/// Tipo de documento de una persona (T-A2-07). Administrable.
model DocumentKind {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  name      String
  hasBack   Boolean          @default(false)
  expires   Boolean          @default(false)
  active    Boolean          @default(true)
  isSystem  Boolean          @default(true)
  order     Int              @default(0)
  documents PersonDocument[]
}

/// Documento privado de una persona. El archivo es un MediaFile privado (sin URL pública).
model PersonDocument {
  id          Int          @id @default(autoincrement())
  personId    Int
  kindId      Int
  mediaFileId Int          @unique
  expiresAt   DateTime?    @db.Date
  notes       String?
  createdAt   DateTime     @default(now())
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind        DocumentKind @relation(fields: [kindId], references: [id])
  mediaFile   MediaFile    @relation(fields: [mediaFileId], references: [id])

  @@index([personId])
  @@index([expiresAt])
}

/// Contacto de una persona (teléfono, correo y parentesco). Datos personales: solo residents.manage.
model PersonContact {
  id           Int      @id @default(autoincrement())
  personId     Int
  name         String
  phone        String?
  email        String?
  relationship String?
  createdAt    DateTime @default(now())
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

enum AuthorizationScope {
  PEDESTRIAN
  VEHICLE
  BOTH
}

/// Persona autorizada a entrar a una propiedad sin ser residente (empleados, familiares que no viven ahí).
/// Vigencia por fechas, horario por días (0=domingo … 6=sábado) y horas en la zona del cliente.
model PropertyAuthorization {
  id          Int                @id @default(autoincrement())
  propertyId  Int
  personId    Int
  scope       AuthorizationScope @default(PEDESTRIAN)
  days        String
  startTime   String
  endTime     String
  validFrom   DateTime           @db.Date
  validUntil  DateTime?          @db.Date
  createdById Int?
  createdAt   DateTime           @default(now())
  revokedAt   DateTime?
  passHash    String?            @unique
  property    Property           @relation(fields: [propertyId], references: [id])
  person      Person             @relation(fields: [personId], references: [id])

  @@index([propertyId, personId])
}

/// Regla global de bloqueo por adeudo. La fila id=1 es la configuración vigente.
model DelinquencyRule {
  id             Int      @id @default(autoincrement())
  enabled        Boolean  @default(true)
  minOverdueDays Int      @default(30)
  blockVisitors  Boolean  @default(true)
  active         Boolean  @default(true)
  updatedById    Int?
  updatedBy      User?    @relation("DelinquencyRuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Excepción temporal de acceso para una propiedad morosa. Solo la crea ADMIN.
model AccessException {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  property    Property  @relation(fields: [propertyId], references: [id])
  reason      String
  validUntil  DateTime
  revokedAt   DateTime?
  createdById Int
  createdBy   User      @relation("AccessExceptionCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([propertyId, validUntil])
}

enum AccessMethod {
  QR
  TAG
  PIN
  MANUAL
}

enum AccessDirection {
  ENTRY
  EXIT
}

enum AccessSource {
  GUARD
  DEVICE
}

enum AccessDecision {
  ALLOWED
  DENIED
}

/// Bitácora única de intentos de acceso.
model AccessEvent {
  id           Int             @id @default(autoincrement())
  propertyId   Int
  property     Property        @relation(fields: [propertyId], references: [id])
  personId     Int?
  person       Person?         @relation("AccessEventPerson", fields: [personId], references: [id], onDelete: SetNull)
  vehicleId    Int?
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  invitationId Int?
  invitation   Invitation?     @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  method       AccessMethod
  direction    AccessDirection
  source       AccessSource    @default(GUARD)
  decision     AccessDecision
  reason       String?
  guardId      Int?
  guard        User?           @relation("AccessEventGuard", fields: [guardId], references: [id], onDelete: SetNull)
  occurredAt   DateTime        @default(now())
  metadata     Json?

  @@index([propertyId, occurredAt])
  @@index([personId, occurredAt])
  @@index([invitationId])
  @@index([vehicleId])
}

enum AnnouncementAudience {
  ALL
  PROPERTY
  ROLE
}

/// Comunicado de administración. Al enviarse crea un Notification por destinatario.
model Announcement {
  id            Int                  @id @default(autoincrement())
  title         String
  body          String
  audience      AnnouncementAudience
  propertyId    Int?
  property      Property?            @relation("AnnouncementProperty", fields: [propertyId], references: [id], onDelete: SetNull)
  roleName      String?
  sentAt        DateTime             @default(now())
  createdById   Int
  createdBy     User                 @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  notifications Notification[]

  @@index([sentAt])
}

enum VehicleStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

/// Vehículo registrado por un residente; administración lo aprueba y asigna tag.
model Vehicle {
  id              Int           @id @default(autoincrement())
  propertyId      Int
  property        Property      @relation(fields: [propertyId], references: [id])
  ownerId         Int
  owner           User          @relation("VehicleOwner", fields: [ownerId], references: [id])
  plate           String
  plateNormalized String
  tagCode         String?       @unique
  kind            String?
  brand           String?
  model           String?
  color           String?
  status          VehicleStatus @default(PENDING)
  approvedById    Int?
  approvedBy      User?         @relation("VehicleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  notes           String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accessEvents    AccessEvent[]

  @@unique([propertyId, plateNormalized])
  @@index([plateNormalized])
  @@index([propertyId, status])
}

/// Clave peatonal del residente. Solo se guarda el HMAC del PIN; el PIN se muestra una vez.
model AccessPin {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  property    Property  @relation(fields: [propertyId], references: [id])
  userId      Int
  user        User      @relation("AccessPinOwner", fields: [userId], references: [id])
  pinHash     String    @unique
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById Int
  createdBy   User      @relation("AccessPinCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([propertyId, active])
  @@index([userId, active])
}

/// Pase QR personal del residente. El token es de corta duración (60 s) y
/// se firma; esta fila es la que permite revocarlo.
model PersonalQrPass {
  id            Int       @id @default(autoincrement())
  propertyId    Int
  property      Property  @relation(fields: [propertyId], references: [id])
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  active        Boolean   @default(true)
  codeHash      String?   @unique
  codeExpiresAt DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, active])
  @@index([propertyId, active])
}

/// Token opaco de refresh, guardado solo como hash. Se rota en cada uso.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}
