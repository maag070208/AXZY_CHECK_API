{
  "name": "checkapp-api",
  "version": "1.4.0",
  "main": "index.ts",
  "license": "MIT",
  "scripts": {
    "dev": "npx nodemon",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "start": "node dist/src/index.js",
    "start:cron": "node dist/print.cron.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "prisma:seed": "node scripts/db-guard.mjs seed && npx prisma db seed",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "node scripts/db-guard.mjs migrate && npx prisma migrate dev",
    "prisma:restore": "node scripts/db-guard.mjs reset && npx prisma migrate reset",
    "prisma:regenerate": "pnpm prisma:generate && pnpm prisma:migrate && pnpm prisma:seed",
    "test": "jest",
    "test:e2e": "jest tests/e2e",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns 'contract' 'security'",
    "test:contract": "jest --testPathPattern contract",
    "test:security": "jest --testPathPattern security",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "api:version": "node scripts/api-version.mjs",
    "e2e:seed": "node scripts/db-guard.mjs e2e:seed && E2E_SEED=1 node scripts/seed-e2e-route.mjs",
    "capacity:check": "NODE_ENV=test ts-node -r tsconfig-paths/register scripts/capacity-check.ts",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/lib-storage": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "^3.1015.0",
    "@prisma/client": "^5.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.17.4",
    "ably": "^2.6.5",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-fileupload": "^1.5.0",
    "express-openapi-validator": "^5.1.2",
    "express-rate-limit": "^7",
    "firebase-admin": "^14.5.0",
    "fs": "^0.0.1-security",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.2.1",
    "path": "^0.12.7",
    "pdfkit": "^0.17.2",
    "pino": "^9",
    "resend": "^6.12.2",
    "swagger-ui-express": "^4.6.0",
    "tsconfig-paths": "^4.2.0",
    "yamljs": "^0.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.34.0",
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "body-parser@<1.20.9": "^1.20.9",
      "qs@<6.16.1": "^6.16.1",
      "follow-redirects@<1.16.2": "^1.16.2",
      "fast-uri@<3.1.9": "^3.1.9",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "uuid@<11.1.1": "^11.1.1",
      "http-cache-semantics@<4.3.0": "^4.3.0"
    }
  }
}
